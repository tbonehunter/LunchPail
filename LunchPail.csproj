<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>LunchPail</AssemblyName>
    <RootNamespace>TBoneHunter.LunchPail</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
    <None Remove="BUGFIX_INSTRUCTIONS.md" />
    <None Remove="DESIGN_NOTES.md" />
    <None Remove="i18n.zip" />
    <None Remove="item list from console commands.txt" />
    <None Remove="kitchek coordinates.txt" />
    <None Remove="Lunch Pail Test.txt" />
    <None Remove="LunchPail.code-workspace" />
    <None Remove="LunchPail.zip" />
    <None Remove="LunchPailUI_DisplayCount_BugFix.md" />
    <None Remove="LunchPail_large.png" />
    <None Remove="SMAPI-latest.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy Assets folder to mod output directory alongside the DLL -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Copy i18n translation files to mod output directory -->
    <Content Include="i18n\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Session Notes\**" />
    <EmbeddedResource Remove="Session Notes\**" />
    <None Remove="Session Notes\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.*" />
  </ItemGroup>

</Project>
