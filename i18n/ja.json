{
  // i18n/ja.json — LunchPail Japanese translations

  "config.section.stamina": "スタミナコンパートメント",
  "config.section.health": "体力コンパートメント",
  "config.section.foodSelection": "食料の選択",
  "config.section.budgetAdjustment": "在庫調整",
